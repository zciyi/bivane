{
  "name": "bivane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bivane /baɪˈveɪn/ — Vant 风格 React 双端组件库（H5 / PC 自适应），shadcn copy-paste 形态分发",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:serve": "node scripts/registry-serve.mjs",
    "registry:publish": "node scripts/publish-registry.mjs",
    "consumer:check": "node scripts/consumer-check.mjs",
    "measure": "node scripts/measure.mjs",
    "demo:single": "vite build && node scripts/build-single-demo.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tweakcn:export": "node scripts/tweakcn-bridge.mjs export --out packages/tokens/tweakcn/bivane-tweakcn.css",
    "tweakcn:import": "node scripts/tweakcn-bridge.mjs import",
    "docs:dev": "vite --config apps/docs/vite.config.ts",
    "docs:build": "vite build --config apps/docs/vite.config.ts",
    "docs:props": "node scripts/extract-props.mjs",
    "docs:registry": "node scripts/build-docs-registry.mjs",
    "docs:examples": "node scripts/extract-examples.mjs",
    "bench:snapshot": "node scripts/bench-snapshot.mjs",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts --port 5172"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
