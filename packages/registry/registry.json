{
    "$schema": "https://ui.shadcn.com/schema/registry.json",
    "name": "bivane",
    "homepage": "https://bivane.dev",
    "items": [
        {
            "name": "utils",
            "type": "registry:lib",
            "title": "cn 工具",
            "description": "clsx + tailwind-merge 的类名合并工具（已注册 --bv-* 命名空间），所有 Bivane 组件的公共依赖。",
            "files": [
                {
                    "path": "lib/utils.ts",
                    "type": "registry:lib",
                    "target": "lib/utils.ts"
                }
            ],
            "dependencies": ["clsx", "tailwind-merge"]
        },
        {
            "name": "portal",
            "type": "registry:lib",
            "title": "Portal 容器",
            "description": "弹层统一挂载点。注意：portal 内容脱离 data-mode 作用域，弹层根元素必须自带 data-mode。",
            "files": [
                {
                    "path": "lib/portal.tsx",
                    "type": "registry:lib",
                    "target": "lib/portal.tsx"
                }
            ],
            "dependencies": ["react-dom"]
        },
