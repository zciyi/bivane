# https://editorconfig.org —— 编辑器/IDE 统一缩进的基础约定
# AI 协作规则见 .trae/rules/code-style.md（规则 1：一律 2 空格缩进）
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 的行尾两空格是换行语法，不能裁
[*.md]
trim_trailing_whitespace = false
